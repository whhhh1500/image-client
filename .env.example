# Copy this file to .env for local development. Never commit real API keys.
image-api-url=https://example.com/v1/images/generations
image-api-key=
image-api-model=gpt-image-2

video-api-url=https://example.com/v1/videos
video-api-key=
video-api-model=grok-imagine-video

llm-api-url=https://example.com/v1
llm-api-key=
llm-api-model=gemini-3.7-flash

# Leave empty to use the default ImageClient/assets directory.
output-dir=
